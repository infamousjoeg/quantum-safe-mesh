# Demo client container
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the demo client
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o demo-client ./demo.go

# Final stage
FROM alpine:3.19

ARG VERSION=dev
LABEL org.opencontainers.image.title="quantum-safe-mesh-demo"
LABEL org.opencontainers.image.description="Post-Quantum Cryptography Demo Client"
LABEL org.opencontainers.image.source="https://github.com/infamousjoeg/quantum-safe-mesh"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install curl and jq for HTTP requests
RUN apk --no-cache add ca-certificates curl jq

WORKDIR /root/

# Copy the binary from builder stage
COPY --from=builder /app/demo-client .

# Copy demo script
COPY scripts/k8s-demo.sh .
RUN chmod +x k8s-demo.sh

# Run the demo
CMD ["./k8s-demo.sh"]